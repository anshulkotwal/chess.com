<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .chessboard{
            display: grid;
            grid-template-columns: repeat(8,minmax(0,1fr));
            grid-template-rows: repeat(8,minmax(0,1fr));
            width: 400px;
            height: 400px;
            transform: rotate(0deg);
            border: 2px solid #8B4513;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        .piece.white{
            color: white;
            filter: drop-shadow(0 0 2px rgba(0,0,0,1));
        }
        .piece.black{
            color: black;
            filter: drop-shadow(0 0 2px rgba(255,255,255,0.5));
        }
        .flipped{
            transform: rotate(180deg);
        }
        .square{
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }
        .square.light{
            background-color: #f0d9b5;
        }
        .square.dark{
            background-color: #b58863;
        }
        .square:hover{
            box-shadow: inset 0 0 0 2px #4ade80;
        }
        .piece{
            font-size: 36px;
            cursor: pointer;
            transition: transform 0.2s ease;
        }
        .piece.draggable{
            cursor: grab;
        }
        .piece.draggable:hover{
            transform: scale(1.1);
        }
        .dragging{
            opacity: 0.5;
        }
        .flipped .piece{
            transform: rotate(180deg);
        }
        .scoreboard {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            border: 2px solid #64748b;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }
        .score-update {
            animation: scoreUpdate 0.5s ease-in-out;
        }
        @keyframes scoreUpdate {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        .captured-piece {
            font-size: 20px;
            margin: 2px;
            opacity: 0.8;
        }
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }
        .status-active {
            background-color: #10b981;
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
        }
        .status-inactive {
            background-color: #6b7280;
        }
        .game-info {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            padding: 8px;
            margin-top: 8px;
        }
    </style>
    <title>Chess.com</title>
</head>

<body>
    <div class="w-full min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center p-4">
        <div class="flex flex-col lg:flex-row items-center gap-8">
            
            <!-- Left Scoreboard -->
            <div class="scoreboard p-6 w-80 text-white">
                <div class="text-center mb-4">
                    <h2 class="text-2xl font-bold text-white mb-2">Live Chess</h2>
                    <div id="game-status" class="text-sm text-gray-300">Waiting for players...</div>
                </div>
                
                <!-- White Player Section -->
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center">
                            <span id="white-status" class="status-indicator status-inactive"></span>
                            <span class="text-lg font-semibold">White Player</span>
                        </div>
                        <div class="text-2xl">♔</div>
                    </div>
                    <div class="bg-slate-700 rounded-lg p-3">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-sm text-gray-300">Material Score:</span>
                            <span id="white-score" class="text-xl font-bold text-white">0</span>
                        </div>
                        <div class="text-sm text-gray-300 mb-1">Captured Pieces:</div>
                        <div id="white-captured" class="min-h-[30px] flex flex-wrap bg-slate-800 rounded p-2"></div>
                    </div>
                </div>
                
                <!-- Black Player Section -->
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center">
                            <span id="black-status" class="status-indicator status-inactive"></span>
                            <span class="text-lg font-semibold">Black Player</span>
                        </div>
                        <div class="text-2xl">♚</div>
                    </div>
                    <div class="bg-slate-700 rounded-lg p-3">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-sm text-gray-300">Material Score:</span>
                            <span id="black-score" class="text-xl font-bold text-white">0</span>
                        </div>
                        <div class="text-sm text-gray-300 mb-1">Captured Pieces:</div>
                        <div id="black-captured" class="min-h-[30px] flex flex-wrap bg-slate-800 rounded p-2"></div>
                    </div>
                </div>
                
                <!-- Game Info -->
                <div class="game-info">
                    <div class="flex justify-between text-sm text-gray-300 mb-1">
                        <span>Current Turn:</span>
                        <span id="current-turn" class="font-semibold">White</span>
                    </div>
                    <div class="flex justify-between text-sm text-gray-300 mb-1">
                        <span>Move Count:</span>
                        <span id="move-count" class="font-semibold">0</span>
                    </div>
                    <div class="flex justify-between text-sm text-gray-300 mb-2">
                        <span>Your Role:</span>
                        <span id="player-role" class="font-semibold">-</span>
                    </div>
                    
                    <!-- Audio Controls -->
                    <div class="border-t border-gray-600 pt-2">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-sm text-gray-300">Sound Effects:</span>
                            <button id="sound-toggle" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs font-semibold transition-colors">
                                ON
                            </button>
                        </div>
                        <div class="flex items-center">
                            <span class="text-xs text-gray-400 mr-2">Volume:</span>
                            <input type="range" id="volume-slider" min="0" max="100" value="50" class="flex-1 h-1 bg-gray-600 rounded-lg appearance-none cursor-pointer">
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Chess Board -->
            <div class="chessboard"></div>
            
            <!-- Right Info Panel -->
            <div class="scoreboard p-6 w-80 text-white">
                <div class="text-center mb-4">
                    <h2 class="text-2xl font-bold text-white mb-2">Game Log</h2>
                </div>
                
                <!-- Move History -->
                <div class="mb-6">
                    <h3 class="text-lg font-semibold mb-2">Recent Moves</h3>
                    <div id="move-history" class="bg-slate-700 rounded-lg p-3 h-48 overflow-y-auto">
                        <div class="text-sm text-gray-400 text-center">Game hasn't started yet</div>
                    </div>
                </div>
                
                <!-- Game Statistics -->
                <div class="game-info">
                    <h3 class="text-lg font-semibold mb-2">Statistics</h3>
                    <div class="flex justify-between text-sm text-gray-300 mb-1">
                        <span>Total Captures:</span>
                        <span id="total-captures">0</span>
                    </div>
                    <div class="flex justify-between text-sm text-gray-300 mb-1">
                        <span>Checks Given:</span>
                        <span id="checks-given">0</span>
                    </div>
                    <div class="flex justify-between text-sm text-gray-300">
                        <span>Game Time:</span>
                        <span id="game-time">0:00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <script src="/js/chessgame.js"></script>
</body>

</html>